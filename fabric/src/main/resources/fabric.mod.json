{
  "schemaVersion": 1,
  "id": "tiertagger",
  "version": "${version}",
  "name": "PrimeTiers Overlay",
  "description": "Displays live PrimeTiers PvP rankings in Minecraft with auto-refreshing tier data and gamemode support.",
  "authors": [
    "Rekaixp"
  ],
  "contact": {
    "sources": "https://github.com/mctiers-dev/TierTagger.git"
  },
  "license": "MPL-2.0",
  "icon": "assets/tiertagger/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.uku3lig.tiertagger.fabric.TierTaggerFabric"
    ],
    "ukulib": [
      "net.uku3lig.tiertagger.config.UkulibIntegration"
    ]
  },
  "mixins": [
    "TierTagger.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18",
    "minecraft": ">=26.1",
    "ukulib": "^2.0.0"
  }
}
